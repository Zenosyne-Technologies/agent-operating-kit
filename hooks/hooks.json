{
  "description": "SessionStart: Marvin kit-version drift check, the user-update rules (unless the project's outputStyle is Marvin's own), the Marvin-marked agent-worktree sweep (worktree_sweep on|check|off) and the Docker sweep (throwaway resources of finished agent worktrees); PostToolUse + UserPromptSubmit: the context ladder and budgets; SessionStart + PostToolUse (Write|Edit|MultiEdit) + SubagentStop + Stop: the run-state sync to the project's per-session run folder (Stop: the catch-up for run files written through Bash); UserPromptSubmit + Stop: the user-update format gate; SubagentStart / SubagentStop (marvin:* personas): rules injection, the FINAL MESSAGE contract gate and the Marvin-owned worktree marker; PreToolUse (Agent): the brief lint; PreToolUse (Bash): the Docker lint (unlabelled resources, compose without -p, throwaway MySQL/MariaDB with binary logging on; docker_lint advise|off); PreToolUse (tracker writes: Jira/Linear/GitHub MCP issue tools, Bash gh issue, Write of Local issue files): the ticket lint (required dimensions, registry values, size/severity only in prose; ticket_lint block|advise|off) — Marvin-installed projects only",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/marvin-session-start.sh", "timeout": 5 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/marvin-runs-sync.sh --session-start", "timeout": 10 }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/marvin-worktree-sweep.sh --hook", "timeout": 20 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/marvin-docker-sweep.sh --hook", "timeout": 20 }
        ]
      }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/marvin-context-budget.sh", "timeout": 5 } ] },
      { "matcher": "Write|Edit|MultiEdit", "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/marvin-runs-sync.sh --post-tool", "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/marvin-context-budget.sh", "timeout": 5 },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/marvin-update-gate.sh", "timeout": 10 }
      ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/marvin-update-gate.sh", "timeout": 10 } ] },
      { "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/marvin-runs-sync.sh --stop", "timeout": 10 } ] }
    ],
    "SubagentStart": [
      { "matcher": "^marvin:", "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/marvin-subagent-rules.sh", "timeout": 5 } ] }
    ],
    "SubagentStop": [
      { "matcher": "^marvin:", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/marvin-subagent-gate.sh", "timeout": 10 },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/marvin-worktree-mark.sh --subagent-stop", "timeout": 5 },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/marvin-runs-sync.sh --subagent-stop", "timeout": 10 }
      ] }
    ],
    "PreToolUse": [
      { "matcher": "Agent|Task", "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/marvin-brief-lint.sh", "timeout": 10 } ] },
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/marvin-docker-lint.sh", "timeout": 5 } ] },
      { "matcher": "^mcp__.*__(createJiraIssue|editJiraIssue|save_issue|create_issue|update_issue|issue_write)$|^Bash$|^Write$", "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/marvin-ticket-lint.sh", "timeout": 10 } ] }
    ]
  }
}
