{
  "description": "SessionStart: Marvin kit-version drift check plus the always-on user-update format rules; PostToolUse + UserPromptSubmit: the context-budget advisory — Marvin-installed projects only",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/marvin-session-start.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/marvin-context-budget.sh", "timeout": 5 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/marvin-context-budget.sh", "timeout": 5 } ] }
    ]
  }
}
